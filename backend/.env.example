# Environment configuration for Weather Anomaly & Tracking Backend
PORT=8000
HOST=0.0.0.0
DEBUG=True

# News API Configuration
# Option 1: NewsAPI.org key (Get free at https://newsapi.org)
NEWS_API_KEY=

# Option 2: Fallback uses GDELT Project 2.0 API & ReliefWeb (No API key required!)
NEWS_PROVIDER_FALLBACK=True

# Weather Data Storage & Cache Directory
CACHE_DIR=backend/data/cache
DATA_DIR=backend/data/raw
DEFAULT_DATASET=synthetic_amphan
